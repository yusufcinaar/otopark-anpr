# Bu dosyayi .env olarak kopyalayip degerleri doldurun. .env dosyasi Git'e EKLENMEZ.

# Operasyon verileri varsayilan olarak %%LOCALAPPDATA%%\OtoparkANPRPublic\data altinda
# kalici tutulur. Gerekirse farkli bir disk/klasor belirtilebilir.
# OTOPARK_DATA_DIR=D:\OtoparkVerileri

# --- SMTP (gunluk e-posta raporu) ---
SMTP_HOST=
SMTP_PORT=587
# password = kullanici + uygulama sifresi, relay = IP yetkili SMTP relay
SMTP_AUTH_MODE=password
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Otopark Yönetim Sistemi
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30

# Gunluk raporun gonderilecegi saat (HH:MM)
DAILY_REPORT_TIME=09:00

# --- Kamera webhook sunucusu (yerel ag) ---
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8090

# --- Otopark ---

# Simulasyon modu: true = sahte kamera/bariyer, false = gercek donanim (webhook/RTSP)
SIMULATION_MODE=true

# PTS hiz alarm siniri (km/sa). 0 = alarm kapali.
SPEED_LIMIT_KMH=0

# Ornek Gmail ayari:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#   SMTP_USERNAME=demo@example.com  SMTP_PASSWORD=<uygulama şifresi>
# Ornek Google Workspace SMTP relay (Google Admin'de tesis IP'si yetkili olmali):
#   SMTP_HOST=smtp-relay.gmail.com  SMTP_PORT=587  SMTP_AUTH_MODE=relay
#   SMTP_USERNAME=  SMTP_PASSWORD=  SMTP_USE_TLS=true
# Ornek Microsoft 365:
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USE_TLS=true

# Optional: verified Metcom OUT3 profile host; leave empty for simulation.
METCOM_PROFILE_HOST=
